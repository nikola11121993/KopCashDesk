<Window x:Class="KopCashDesk.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="КОП Кассы — рабочее место" Width="1360" Height="850" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F7FA" Loaded="MainWindow_Loaded">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Файл">
        <MenuItem Header="Импорт архивов Сбер..." Click="SberImport_Click"/>
        <Separator/>
        <MenuItem Header="Создать организацию..." Click="NewOrganization_Click"/>
        <MenuItem Header="Резервная копия..." Click="Backup_Click"/>
        <Separator/>
        <MenuItem Header="Выход" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Справочники">
        <MenuItem Header="Организации" Click="Organizations_Click"/>
        <MenuItem Header="Торговые точки" Click="Locations_Click"/>
      </MenuItem>
      <MenuItem Header="_Сервис">
        <MenuItem Header="Импорт архивов Сбер..." Click="SberImport_Click"/>
        <Separator/>
        <MenuItem Header="Интеграции" Click="Integrations_Click"/>
        <MenuItem Header="Такском — логин и пароль..." Click="TaxcomSettings_Click"/>
        <Separator/>
        <MenuItem Header="Параметры" Click="Settings_Click"/>
        <MenuItem Header="Журнал событий" Click="Journal_Click"/>
      </MenuItem>
      <MenuItem Header="_Справка">
        <MenuItem Header="Руководство пользователя   F1" Click="Help_Click"/>
        <MenuItem Header="О программе" Click="About_Click"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE2E9" BorderThickness="0,0,0,1" Padding="20,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="КОП Кассы" FontSize="23" FontWeight="SemiBold" Foreground="#193B36"/>
          <TextBlock Text="Учёт и сверка кассовой выручки" Foreground="#64748B"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="Организация:" VerticalAlignment="Center" Margin="12,0,8,0"/>
          <ComboBox x:Name="OrganizationFilter" Width="260" DisplayMemberPath="Name" SelectionChanged="OrganizationFilter_SelectionChangedV04"/>
          <Button Content="Обновить" Click="RefreshV04_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="White">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Готово"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="DatabaseText"/></StatusBarItem>
      <Separator/>
      <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="v0.4.2"/></StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#193B36">
        <StackPanel Margin="12,18">
          <TextBlock Text="РАЗДЕЛЫ" Foreground="#A9C7C0" FontSize="11" Margin="12,0,0,10"/>
          <Button Content="Рабочий стол" Tag="home" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Организации" Tag="organizations" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Торговые точки" Tag="locations" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Свод по точкам" Click="Summary_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Операции" Tag="operations" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Сверка" Tag="reconciliation" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Separator Margin="4,12"/>
          <Button Content="Сбер — импорт архивов" Click="SberImport_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Интеграции" Tag="integrations" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Такском — настройки" Click="TaxcomSettings_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Настройки" Tag="settings" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Журнал событий" Tag="journal" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Button Content="Помощь" Tag="help" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Рабочий стол" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageSubtitle" Text="Обзор состояния системы" Foreground="#64748B" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
            <Button x:Name="PrimaryButton" Content="Добавить" Click="PrimaryButton_Click" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DCE2E9" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Width="340" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по названию, адресу и ИНН"/>
            <Button Content="Сбросить" Click="ClearSearch_Click"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE2E9" BorderThickness="1" CornerRadius="6">
          <Grid><ContentControl x:Name="PageContent" Margin="16"/></Grid>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
