<Window x:Class="KopCashDesk.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Контроль выручки" Width="1360" Height="850" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F7FA" Loaded="ModernMainWindow_Loaded">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Файл">
        <MenuItem Header="Импорт файлов..." Click="UnifiedImport_Click"/>
        <Separator/>
        <MenuItem Header="Создать организацию..." Click="NewOrganization_Click"/>
        <MenuItem Header="Резервная копия..." Click="Backup_Click"/>
        <Separator/>
        <MenuItem Header="Выход" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Справочники">
        <MenuItem Header="Организации" Click="Organizations_Click"/>
        <MenuItem Header="Точки и ККТ" Click="Registers_Click"/>
        <MenuItem Header="Терминалы" Click="Terminals_Click"/>
        <Separator/>
        <MenuItem Header="Объединить торговые точки..." Click="MergeLocations_Click"/>
      </MenuItem>
      <MenuItem Header="_Сервис">
        <MenuItem Header="Импорт файлов..." Click="UnifiedImport_Click"/>
        <Separator/>
        <MenuItem Header="Интеграции" Click="Integrations_Click"/>
        <MenuItem Header="Такском — логин и пароль..." Click="TaxcomSettings_Click"/>
        <Separator/>
        <MenuItem Header="Параметры" Click="Settings_Click"/>
        <MenuItem Header="Журнал событий" Click="Journal_Click"/>
      </MenuItem>
      <MenuItem Header="_Справка">
        <MenuItem Header="Руководство пользователя   F1" Click="Help_Click"/>
        <MenuItem Header="О программе" Click="AboutVNext_Click"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE2E9" BorderThickness="0,0,0,1" Padding="20,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Контроль выручки" FontSize="22" FontWeight="SemiBold" Foreground="#193B36"/>
          <TextBlock Text="Касса • терминалы • смены" Foreground="#64748B"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="Организация:" VerticalAlignment="Center" Margin="12,0,8,0"/>
          <ComboBox x:Name="OrganizationFilter" Width="260" DisplayMemberPath="Name" SelectionChanged="OrganizationFilter_SelectionChangedV04"/>
          <Button Content="Обновить" Click="RefreshV04_Click" Padding="10,4" MinHeight="28"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="White">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Готово"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="DatabaseText"/></StatusBarItem>
      <Separator/>
      <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="VersionText"/></StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#193B36">
        <StackPanel Margin="10,16">
          <StackPanel.Resources>
            <Style TargetType="Button">
              <Setter Property="Padding" Value="9,4"/>
              <Setter Property="Margin" Value="1,2"/>
              <Setter Property="MinHeight" Value="29"/>
              <Setter Property="FontSize" Value="12"/>
              <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
          </StackPanel.Resources>
          <TextBlock Text="РАЗДЕЛЫ" Foreground="#A9C7C0" FontSize="11" Margin="10,0,0,8"/>
          <Button Content="Организации" Tag="organizations" Click="Navigate_Click"/>
          <Button Content="Точки и ККТ" Click="Registers_Click"/>
          <Button Content="Терминалы" Click="Terminals_Click"/>
          <Button Content="Свод" Click="ModernSummary_Click"/>
          <Button Content="Сверка касса ↔ терминал" Click="ModernReconciliation_Click"/>
          <Button Content="Операции" Tag="operations" Click="Navigate_Click"/>
          <Separator Margin="4,9"/>
          <Button Content="Импорт файлов" Click="UnifiedImport_Click" ToolTip="Сбер ZIP/XLSX, Такском XLSX/ZIP, Frontol report.txt и CRPT"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Свод" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageSubtitle" Text="Терминалы и касса по торговым точкам" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
            <Button x:Name="PrimaryButton" Content="Добавить" Click="PrimaryButton_Click" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
        <Border x:Name="SearchPanel" Grid.Row="1" Background="White" BorderBrush="#DCE2E9" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Width="340" TextChanged="SearchBox_TextChanged" IsEnabledChanged="SearchBox_IsEnabledChanged" ToolTip="Поиск по названию, адресу и ИНН"/>
            <Button Content="Сбросить" Click="ClearSearch_Click" Padding="10,4" MinHeight="28"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DCE2E9" BorderThickness="1" CornerRadius="6">
          <Grid><ContentControl x:Name="PageContent" Margin="14"/></Grid>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
