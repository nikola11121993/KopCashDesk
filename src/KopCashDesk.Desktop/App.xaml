<Application x:Class="KopCashDesk.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#176B5B" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F7FA" />
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="30"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="30"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="32"/><Setter Property="ColumnHeaderHeight" Value="36"/></Style>
  </Application.Resources>
</Application>
